#!/bin/bash
#
# automatica-secrets: per-device secrets for the Automatica.Core Raspberry Pi image.
#
# Older images shipped the same MariaDB root password, Postgres "postgres/postgres", one TLS key
# baked into the image and a NOPASSWD sudo login for everyone. This script replaces all of that
# with values generated on the device itself.
#
#   automatica-secrets init           First boot (automatica-secrets.service): create the
#                                     per-device database passwords if they are missing and
#                                     write them into the core config. Idempotent.
#   automatica-secrets satellite-key  Satellite image: print the client id and key this device
#                                     generated at first boot, to enter on the core.
#   automatica-secrets tls [--force]  Create the nginx TLS key and certificate if they are
#                                     missing (automatica-tls.service). --force replaces them.
#   automatica-secrets rotate         For devices flashed from an older image: new random
#                                     MariaDB and Postgres passwords, core gets its own DB users
#                                     instead of root/postgres, both DBs only on 127.0.0.1, new
#                                     TLS key, TLSv1.1 off. Reboot afterwards.
#   automatica-secrets harden-login [USER]
#                                     For devices flashed from an older image: remove NOPASSWD
#                                     sudo and the docker group, force a new password if the
#                                     published default is still set, pubkey-only SSH if the
#                                     user has authorized_keys.
#   automatica-secrets write-units ROOT
#                                     Image build only: write the database systemd units and
#                                     helper files below ROOT.
#
# Copy it to an existing device and run "sudo bash automatica-secrets rotate" followed by
# "sudo bash automatica-secrets harden-login" and a reboot.
#
# All passwords are 48 hex characters, so they need no quoting in JSON, SQL or connection strings.

set -euo pipefail

SECRETS_DIR=/etc/automatica
MARIADB_ENV=${SECRETS_DIR}/mariadb.env
TIMESCALE_ENV=${SECRETS_DIR}/timescaledb.env
CORE_DB_ENV=${SECRETS_DIR}/core-db.env
MARIADB_INIT_DIR=${SECRETS_DIR}/mariadb-init
SHARE_DIR=/usr/local/share/automatica
TIMESCALE_INIT=${SHARE_DIR}/timescale-init.sh
CORE_CONFIG=/var/lib/automatica/config/appsettings.json
SATELLITE_CONFIG=/var/lib/satellite/appsettings.json
TLS_KEY=/etc/ssl/private/automatica.key
TLS_CRT=/etc/ssl/certs/automatica.crt
LEGACY_TLS_KEY=/etc/ssl/certs/automatica.key
# container names the units use (overridable for tests)
MARIADB_CONTAINER=${MARIADB_CONTAINER:-mariadb}
TIMESCALE_CONTAINER=${TIMESCALE_CONTAINER:-timescaledb}
NGINX_CONF=/etc/nginx/nginx.conf

# Third-party images pinned by digest (multi-arch index). Bump deliberately: pull the tag, run
# "docker buildx imagetools inspect <tag>" and copy the index digest.
# yobasystems/alpine-mariadb:armhf (linux/arm/v7)
MARIADB_IMAGE=yobasystems/alpine-mariadb@sha256:fded7b1f41ce923f1243106889bad99b221e3a8bf2f8adb51511f182fcef433f
# timescale/timescaledb:latest-pg15 (PostgreSQL 15, keep the major version)
TIMESCALE_IMAGE=timescale/timescaledb@sha256:6343bdc87ca132c6b53acb26113a6bad1821d188fa39975a745f32ddd9757634

# The login password every older image shipped with (config FIRST_USER_PASS)
PUBLISHED_DEFAULT_PASSWORDS="automatica raspberry"

log() { echo "automatica-secrets: $*" >&2; }
die() { log "error: $*"; exit 1; }

require_root() {
	[ "$(id -u)" = "0" ] || die "run as root"
}

new_password() {
	openssl rand -hex 24
}

# write_file MODE PATH: stdin -> PATH, atomically, owned by root
write_file() {
	local mode=$1 path=$2 tmp
	tmp=$(mktemp "$(dirname "$path")/.$(basename "$path").XXXXXX")
	chmod "$mode" "$tmp"
	cat > "$tmp"
	chown root:root "$tmp" 2>/dev/null || true
	mv -f "$tmp" "$path"
}

env_value() {
	# env_value FILE KEY
	sed -n "s/^$2=//p" "$1" | head -n 1
}

ensure_secrets_dir() {
	install -d -m 0700 -o root -g root "$SECRETS_DIR"
	install -d -m 0700 -o root -g root "$MARIADB_INIT_DIR"
}

# write_secret_files MARIADB_ROOT MARIADB_CORE POSTGRES_ROOT POSTGRES_CORE
write_secret_files() {
	ensure_secrets_dir
	# --env-file for the containers: values never show up in a command line
	write_file 600 "$MARIADB_ENV" <<-EOF
		MYSQL_ROOT_PASSWORD=$1
		MYSQL_DATABASE=automatica
	EOF
	write_file 600 "$TIMESCALE_ENV" <<-EOF
		POSTGRES_PASSWORD=$3
		AUTOMATICA_DB_PASSWORD=$4
	EOF
	# what the core config needs, kept so a half-finished first boot can be completed
	write_file 600 "$CORE_DB_ENV" <<-EOF
		MARIADB_PASSWORD=$2
		POSTGRES_PASSWORD=$4
	EOF
	# Runs once, when MariaDB creates an empty data directory (MYSQL_DATABASE must be set).
	# The image's own "MYSQL_USER" path would print the password to the journal.
	write_file 600 "${MARIADB_INIT_DIR}/10-automatica.sql" <<-EOF
		CREATE USER IF NOT EXISTS 'automatica'@'%' IDENTIFIED BY '$2';
		GRANT ALL PRIVILEGES ON \`automatica\`.* TO 'automatica'@'%';
		DROP USER IF EXISTS 'root'@'%';
		-- anonymous accounts from mariadb-install-db
		DELETE FROM mysql.global_priv WHERE User='';
		FLUSH PRIVILEGES;
	EOF
}

# render_core_config MARIADB_CORE POSTGRES_CORE: fill the @...@ placeholders of a fresh image
render_core_config() {
	[ -f "$CORE_CONFIG" ] || return 0
	if grep -q '@MARIADB_PASSWORD@\|@POSTGRES_PASSWORD@' "$CORE_CONFIG"; then
		sed -e "s/@MARIADB_PASSWORD@/$1/g" -e "s/@POSTGRES_PASSWORD@/$2/g" "$CORE_CONFIG" \
			| write_file 600 "$CORE_CONFIG"
		log "wrote the database passwords into $CORE_CONFIG"
	fi
	chmod 600 "$CORE_CONFIG"
}

# render_satellite_config: per-device MQTT client id and key instead of the shared rm1/rm1
render_satellite_config() {
	[ -f "$SATELLITE_CONFIG" ] || return 0
	if grep -q '@SATELLITE_CLIENT_ID@\|@SATELLITE_CLIENT_KEY@' "$SATELLITE_CONFIG"; then
		local id key
		id=$(hostname | tr -cd 'A-Za-z0-9._-')
		[ -n "$id" ] || id=satellite
		# 256 bit, base64url without padding (same format as the core's SatelliteClientKey.Generate)
		key=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n')
		sed -e "s/@SATELLITE_CLIENT_ID@/$id/g" -e "s/@SATELLITE_CLIENT_KEY@/$key/g" "$SATELLITE_CONFIG" \
			| write_file 600 "$SATELLITE_CONFIG"
		log "generated the satellite client key, show it with 'sudo automatica-secrets satellite-key'"
	fi
	chmod 600 "$SATELLITE_CONFIG"
}

cmd_satellite_key() {
	require_root
	[ -f "$SATELLITE_CONFIG" ] || die "$SATELLITE_CONFIG not found (not a satellite image)"
	grep -E '"(master|clientId|clientKey)"' "$SATELLITE_CONFIG" | sed -e 's/^[[:space:]]*//' -e 's/,$//'
}

cmd_init() {
	require_root
	if [ ! -s "$MARIADB_ENV" ] || [ ! -s "$TIMESCALE_ENV" ] || [ ! -s "$CORE_DB_ENV" ]; then
		if [ -d /var/lib/mysql/mysql ]; then
			# An existing database still has the passwords it was created with; generating new
			# ones here would lock core out. That is what "rotate" is for.
			log "database already initialised without per-device secrets, run 'automatica-secrets rotate'"
		else
			log "generating per-device database passwords"
			write_secret_files "$(new_password)" "$(new_password)" "$(new_password)" "$(new_password)"
		fi
	fi
	render_satellite_config
	if [ -s "$CORE_DB_ENV" ]; then
		render_core_config "$(env_value "$CORE_DB_ENV" MARIADB_PASSWORD)" "$(env_value "$CORE_DB_ENV" POSTGRES_PASSWORD)"
	fi
}

cmd_tls() {
	require_root
	local force=0
	[ "${1:-}" = "--force" ] && force=1
	if [ "$force" = "0" ] && [ -s "$TLS_KEY" ] && [ -s "$TLS_CRT" ]; then
		return 0
	fi
	local host tmpkey tmpcrt
	host=$(hostname)
	[ -d /etc/ssl/private ] || install -d -m 0700 -o root -g root /etc/ssl/private
	tmpkey=$(mktemp /etc/ssl/private/.automatica.key.XXXXXX)
	tmpcrt=$(mktemp /etc/ssl/certs/.automatica.crt.XXXXXX)
	chmod 600 "$tmpkey"
	openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
		-subj "/O=Automatica.Core/CN=${host}" \
		-addext "subjectAltName=DNS:${host},DNS:${host}.local,DNS:localhost,IP:127.0.0.1" \
		-keyout "$tmpkey" -out "$tmpcrt" 2>/dev/null
	chmod 644 "$tmpcrt"
	mv -f "$tmpkey" "$TLS_KEY"
	mv -f "$tmpcrt" "$TLS_CRT"
	# the key older images baked in (identical on every device)
	rm -f "$LEGACY_TLS_KEY"
	log "created a new TLS key for ${host}"
}

# write_units ROOT: the database units. "rotate" uses the same function on a running device.
cmd_write_units() {
	local root=${1:-}
	[ -n "$root" ] || die "usage: write-units ROOT"
	install -d -m 0755 "${root}/lib/systemd/system" "${root}${SHARE_DIR}"

	write_file 644 "${root}/lib/systemd/system/automatica-secrets.service" <<-'EOF'
		[Unit]
		Description=Automatica per-device database secrets
		After=local-fs.target
		Before=mariadb.service timescaledb.service supervisor.service

		[Service]
		Type=oneshot
		RemainAfterExit=yes
		ExecStart=/usr/local/sbin/automatica-secrets init

		[Install]
		WantedBy=multi-user.target
	EOF

	# 127.0.0.1 only: core runs with host networking and reaches it through the published port.
	write_file 644 "${root}/lib/systemd/system/mariadb.service" <<-EOF
		[Unit]
		Description=MariaDB
		After=docker.service automatica-secrets.service
		Requires=docker.service automatica-secrets.service
		StartLimitInterval=200
		StartLimitBurst=5

		[Service]
		TimeoutStartSec=300
		Restart=always
		ExecStartPre=-/usr/bin/docker stop mariadb
		ExecStartPre=-/usr/bin/docker rm mariadb
		ExecStartPre=-/usr/bin/docker pull ${MARIADB_IMAGE}
		ExecStart=/usr/bin/docker run --rm --name mariadb -p 127.0.0.1:3306:3306 -v /var/lib/mysql:/var/lib/mysql -v ${MARIADB_INIT_DIR}:/docker-entrypoint-initdb.d:ro --env-file ${MARIADB_ENV} ${MARIADB_IMAGE}

		[Install]
		WantedBy=multi-user.target
	EOF

	write_file 644 "${root}/lib/systemd/system/timescaledb.service" <<-EOF
		[Unit]
		Description=Automatica.TimescaleDB
		After=docker.service automatica-secrets.service
		Requires=docker.service automatica-secrets.service
		StartLimitInterval=200
		StartLimitBurst=5

		[Service]
		TimeoutStartSec=300
		Restart=always
		RestartSec=5s
		RestartSteps=10s
		RestartMaxDelaySec=300s

		ExecStartPre=-/usr/bin/docker stop timescaledb
		ExecStartPre=-/usr/bin/docker rm timescaledb
		ExecStartPre=-/usr/bin/docker pull ${TIMESCALE_IMAGE}
		ExecStart=/usr/bin/docker run --rm --name timescaledb -p 127.0.0.1:5432:5432 -v /var/lib/timescaledb:/var/lib/postgresql/data -v ${TIMESCALE_INIT}:/docker-entrypoint-initdb.d/100-automatica.sh:ro -e PGDATA=/var/lib/postgresql/data --env-file ${TIMESCALE_ENV} ${TIMESCALE_IMAGE}

		[Install]
		WantedBy=multi-user.target
	EOF

	# Sourced by the postgres entrypoint once, when it creates an empty data directory, after the
	# image's own 000_install_timescaledb.sh. Must not change shell options (it is sourced).
	write_file 644 "${root}${TIMESCALE_INIT}" <<-'EOF'
		# Automatica: core gets its own login that owns the "automatica" database, not the superuser.
		psql -v ON_ERROR_STOP=1 --username "${POSTGRES_USER:-postgres}" --dbname postgres <<EOSQL
		CREATE ROLE automatica LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD '${AUTOMATICA_DB_PASSWORD}';
		CREATE DATABASE automatica OWNER automatica;
		EOSQL
		psql -v ON_ERROR_STOP=1 --username "${POSTGRES_USER:-postgres}" --dbname automatica -c 'CREATE EXTENSION IF NOT EXISTS timescaledb;'
	EOF
}

container_running() {
	[ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]
}

current_mariadb_root_password() {
	if [ -n "${OLD_MARIADB_ROOT_PASSWORD:-}" ]; then
		echo "$OLD_MARIADB_ROOT_PASSWORD"
	elif [ -s "$MARIADB_ENV" ]; then
		env_value "$MARIADB_ENV" MYSQL_ROOT_PASSWORD
	else
		# older images: "-e MYSQL_ROOT_PASSWORD=..." in the unit file
		sed -n 's/.*MYSQL_ROOT_PASSWORD=\([^ ]*\).*/\1/p' /lib/systemd/system/mariadb.service | head -n 1
	fi
}

core_maria_database() {
	local db=automatica
	if [ -f "$CORE_CONFIG" ]; then
		local found
		found=$(sed -n 's/.*"AutomaticaDatabaseMaria"[^"]*"[^"]*Database=\([A-Za-z0-9_]*\).*/\1/p' "$CORE_CONFIG" | head -n 1)
		[ -n "$found" ] && db=$found
	fi
	echo "$db"
}

cmd_rotate() {
	require_root
	command -v docker >/dev/null || die "docker not found"
	container_running "$MARIADB_CONTAINER" || die "the mariadb container is not running (systemctl start mariadb)"

	local old_root mclient db have_pg=0
	old_root=$(current_mariadb_root_password)
	[ -n "$old_root" ] || die "current MariaDB root password unknown, set OLD_MARIADB_ROOT_PASSWORD"
	mclient=$(docker exec "$MARIADB_CONTAINER" sh -c 'command -v mariadb || command -v mysql')
	db=$(core_maria_database)
	if container_running "$TIMESCALE_CONTAINER"; then
		have_pg=1
	elif [ -d /var/lib/timescaledb/base ]; then
		die "the timescaledb container is not running but has data (systemctl start timescaledb)"
	fi

	local maria_root maria_core pg_root pg_core
	maria_root=$(new_password)
	maria_core=$(new_password)
	pg_root=$(new_password)
	pg_core=$(new_password)

	export MYSQL_PWD="$old_root"
	docker exec -e MYSQL_PWD "$MARIADB_CONTAINER" "$mclient" -uroot -e 'SELECT 1' >/dev/null \
		|| die "cannot log in to MariaDB as root with the current password"

	# Keep the old values until everything below has worked
	ensure_secrets_dir
	local stamp backup
	stamp=$(date +%Y%m%d%H%M%S)
	backup="${SECRETS_DIR}/backup-${stamp}"
	install -d -m 0700 "$backup"
	[ -f "$CORE_CONFIG" ] && cp -p "$CORE_CONFIG" "$backup/"
	cp -p /lib/systemd/system/mariadb.service "$backup/" 2>/dev/null || true
	cp -p /lib/systemd/system/timescaledb.service "$backup/" 2>/dev/null || true
	cp -p "$NGINX_CONF" "$backup/" 2>/dev/null || true
	chmod -R go-rwx "$backup"

	log "MariaDB: user 'automatica' for database '${db}', new root password"
	local drop_users settings_table
	# root from anywhere but the local socket, and the anonymous accounts of mariadb-install-db
	drop_users=$(docker exec -e MYSQL_PWD "$MARIADB_CONTAINER" "$mclient" -uroot -N -B \
		-e "SELECT CONCAT(QUOTE(User),'@',QUOTE(Host)) FROM mysql.user WHERE (User='root' AND Host<>'localhost') OR User=''")
	settings_table=$(docker exec -e MYSQL_PWD "$MARIADB_CONTAINER" "$mclient" -uroot -N -B \
		-e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${db}' AND table_name='Settings'")
	{
		echo "CREATE DATABASE IF NOT EXISTS \`${db}\`;"
		echo "CREATE USER IF NOT EXISTS 'automatica'@'%' IDENTIFIED BY '${maria_core}';"
		echo "ALTER USER 'automatica'@'%' IDENTIFIED BY '${maria_core}';"
		echo "GRANT ALL PRIVILEGES ON \`${db}\`.* TO 'automatica'@'%';"
		if [ "$settings_table" != "0" ]; then
			# HyperSeries credentials are copied into the core DB on first start and override
			# appsettings.json from then on
			echo "UPDATE \`${db}\`.\`Settings\` SET ValueText='automatica' WHERE ValueKey='hyperSeriesUser';"
			echo "UPDATE \`${db}\`.\`Settings\` SET ValueText='${pg_core}' WHERE ValueKey='hyperSeriesPassword';"
		fi
		local u
		for u in $drop_users; do
			echo "DROP USER IF EXISTS ${u};"
		done
		echo "ALTER USER 'root'@'localhost' IDENTIFIED BY '${maria_root}';"
		echo "FLUSH PRIVILEGES;"
	} | docker exec -i -e MYSQL_PWD "$MARIADB_CONTAINER" "$mclient" -uroot
	unset MYSQL_PWD

	if [ "$have_pg" = "1" ]; then
		log "Postgres: role 'automatica' owns database 'automatica', new postgres password"
		docker exec -i -u postgres "$TIMESCALE_CONTAINER" psql -q -v ON_ERROR_STOP=1 --dbname postgres <<-EOSQL
			ALTER ROLE postgres PASSWORD '${pg_root}';
			DO \$\$BEGIN
			  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'automatica') THEN
			    CREATE ROLE automatica LOGIN;
			  END IF;
			END\$\$;
			ALTER ROLE automatica WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD '${pg_core}';
			SELECT 'CREATE DATABASE automatica OWNER automatica'
			  WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'automatica')\gexec
			ALTER DATABASE automatica OWNER TO automatica;
			\connect automatica
			CREATE EXTENSION IF NOT EXISTS timescaledb;
			GRANT ALL ON SCHEMA public TO automatica;
			DO \$\$DECLARE r record;
			BEGIN
			  FOR r IN SELECT schemaname, tablename FROM pg_tables WHERE schemaname = 'public' LOOP
			    EXECUTE format('ALTER TABLE %I.%I OWNER TO automatica', r.schemaname, r.tablename);
			  END LOOP;
			  FOR r IN SELECT sequence_schema, sequence_name FROM information_schema.sequences WHERE sequence_schema = 'public' LOOP
			    EXECUTE format('ALTER SEQUENCE %I.%I OWNER TO automatica', r.sequence_schema, r.sequence_name);
			  END LOOP;
			END\$\$;
		EOSQL
	else
		log "Postgres: timescaledb container not running, its new password applies when its data directory is created"
	fi

	write_secret_files "$maria_root" "$maria_core" "$pg_root" "$pg_core"

	if [ -f "$CORE_CONFIG" ]; then
		log "updating $CORE_CONFIG"
		sed -e "/\"AutomaticaDatabaseMaria\"/ {
				s/Server=[^;\"]*/Server=127.0.0.1/
				s/User Id=[^;\"]*/User Id=automatica/
				s/Password=[^;\"]*/Password=${maria_core}/
			}" \
			-e "s/\(\"hyperSeriesUser\"[[:space:]]*:[[:space:]]*\"\)[^\"]*\"/\1automatica\"/" \
			-e "s/\(\"hyperSeriesPassword\"[[:space:]]*:[[:space:]]*\"\)[^\"]*\"/\1${pg_core}\"/" \
			"$CORE_CONFIG" | write_file 600 "$CORE_CONFIG"
	fi

	cmd_write_units /
	systemctl daemon-reload
	systemctl enable automatica-secrets.service >/dev/null 2>&1 || true

	if [ -f "$NGINX_CONF" ]; then
		log "nginx: per-device TLS key, TLSv1.2+"
		cmd_tls --force
		sed -i -e "s#^\([[:space:]]*ssl_certificate_key\).*#\1       ${TLS_KEY};#" \
			-e "s#^\([[:space:]]*ssl_certificate\)[[:space:]].*#\1           ${TLS_CRT};#" \
			-e "s#^\([[:space:]]*ssl_protocols\).*#\1             TLSv1.2 TLSv1.3;#" \
			-e "s#^\([[:space:]]*ssl_stapling\)[[:space:]].*#\1              off;#" \
			-e "s#^\([[:space:]]*ssl_stapling_verify\).*#\1       off;#" \
			"$NGINX_CONF"
		if nginx -t >/dev/null 2>&1; then
			systemctl reload nginx || true
		else
			log "warning: nginx -t failed, restoring the previous nginx.conf from $backup"
			cp -p "$backup/nginx.conf" "$NGINX_CONF"
		fi
	fi

	log "done. Old files are in $backup (root only, delete it once the device works)."
	log "Reboot now so core and both databases start with the new settings: sudo reboot"
}

password_is_published_default() {
	# password_is_published_default USER: 0 = default, 1 = not default, 2 = unknown
	local user=$1 hash salt pw
	hash=$(getent shadow "$user" | cut -d: -f2)
	case "$hash" in
		'$6$'*)
			salt=$(echo "$hash" | cut -d'$' -f3)
			for pw in $PUBLISHED_DEFAULT_PASSWORDS; do
				[ "$(openssl passwd -6 -salt "$salt" "$pw")" = "$hash" ] && return 0
			done
			return 1 ;;
		'!'*|'*'*|'') return 1 ;;  # locked or no password
		*) return 2 ;;
	esac
}

cmd_harden_login() {
	require_root
	local user=${1:-$(getent passwd 1000 | cut -d: -f1)}
	[ -n "$user" ] && id "$user" >/dev/null 2>&1 || die "user '${user}' not found"

	local f
	for f in /etc/sudoers.d/*; do
		[ -f "$f" ] || continue
		if grep -qE "^[[:space:]]*${user}[[:space:]].*NOPASSWD" "$f"; then
			log "removing NOPASSWD sudo for ${user} ($f)"
			# keep the file: raspberrypi-sys-mods edits 010_pi-nopasswd when a user is renamed
			echo "# NOPASSWD removed by automatica-secrets: sudo asks for the password" | write_file 440 "$f"
		fi
	done
	visudo -c >/dev/null || die "sudoers check failed"

	if id -nG "$user" | tr ' ' '\n' | grep -qx docker; then
		log "removing ${user} from the docker group (docker = root without a password)"
		gpasswd -d "$user" docker >/dev/null
	fi

	local rc=0
	password_is_published_default "$user" || rc=$?
	case $rc in
		0) log "${user} still has the published default password: it must be changed at the next login"
		   passwd --expire "$user" >/dev/null ;;
		2) log "could not check ${user}'s password hash, change it with: sudo passwd ${user}" ;;
	esac

	local home keys
	home=$(getent passwd "$user" | cut -d: -f6)
	keys="${home}/.ssh/authorized_keys"
	install -d -m 0755 /etc/ssh/sshd_config.d
	if [ -s "$keys" ]; then
		log "SSH: ${user} has authorized_keys, turning password logins off"
		write_file 644 /etc/ssh/sshd_config.d/10-automatica.conf <<-'EOF'
			# automatica-secrets harden-login
			PermitRootLogin no
			PasswordAuthentication no
			ChallengeResponseAuthentication no
		EOF
	else
		log "SSH: no authorized_keys for ${user}; password logins stay on. Add a key and re-run, or: sudo systemctl disable --now ssh"
		write_file 644 /etc/ssh/sshd_config.d/10-automatica.conf <<-'EOF'
			# automatica-secrets harden-login
			PermitRootLogin no
		EOF
	fi
	if sshd -t 2>/dev/null; then
		systemctl reload ssh 2>/dev/null || true
	else
		rm -f /etc/ssh/sshd_config.d/10-automatica.conf
		log "warning: sshd -t failed, SSH config left unchanged"
	fi
}

case "${1:-}" in
	init) cmd_init ;;
	satellite-key) cmd_satellite_key ;;
	tls) shift; cmd_tls "$@" ;;
	rotate) cmd_rotate ;;
	harden-login) shift; cmd_harden_login "$@" ;;
	write-units) shift; cmd_write_units "$@" ;;
	*) sed -n '3,32p' "$0" >&2; exit 2 ;;
esac
